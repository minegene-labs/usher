# Copy to site.env in Usher's install folder on the server (/opt/usher by default; see deploy/README.md) and fill in.
# Never commit the real file.
# Every setting lives in config/usher.toml (start from deploy/usher.example.toml). This file only holds what setup.sh
# and the container need before that file is read.

# The repo the server pulls from, a public https:// address (setup.sh clones it)
USHER_REPO=https://github.com/example/usher.git

# The container's time zone. The times in Status and messages follow server.utc_offset_minutes in usher.toml.
TZ=Etc/UTC
