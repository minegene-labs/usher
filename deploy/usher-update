#!/usr/bin/env bash
# Update Usher to its newest release: set USHER_VERSION in .env, pull that image, restart, let Docker Compose wait
# until the new container is healthy, and put the previous version back if it isn't within 2 minutes.
#   usher-update         update now, by hand
#   usher-update --auto  for the daily timer, which is off unless you turn it on: quiet unless it updates, and a
#                        version that failed is not tried again until a newer release comes out
# Every run that reaches GitHub also tells Usher the newest release it saw (Settings → About → Updates).
# Installed by hand (setup.sh), so a release can't change what runs as root. See deploy/README.md.
set -euo pipefail
# The install folder: USHER_HOME in /etc/default/usher (setup.sh writes it), or /opt/usher by default.
# The file is read, not sourced, since this runs as root. USHER_HOME in the environment wins (tests).
CONF=${USHER_DEPLOY_CONF:-/etc/default/usher}
if [ -z "${USHER_HOME:-}" ] && [ -r "$CONF" ]; then
  USHER_HOME=$(sed -n 's/^USHER_HOME=//p' "$CONF" | tail -n 1)
  USHER_HOME=${USHER_HOME#\"}; USHER_HOME=${USHER_HOME%\"}
fi
DIR=${USHER_HOME:-/opt/usher}
case $DIR in
  /*) ;;
  *) echo "USHER_HOME must be a full path, not '$DIR' (in $CONF)" >&2; exit 1 ;;
esac
[ -f "$DIR/compose.yaml" ] || { echo "No Usher install in $DIR (USHER_HOME in $CONF)." >&2; exit 1; }
STATE=${USHER_STATE:-/var/lib/usher-deploy}
export GIT_TERMINAL_PROMPT=0   # a request that asks for a login fails instead of waiting
case ${1:-} in
  "") AUTO=0 ;;
  --auto) AUTO=1 ;;
  *) echo "Usage: usher-update [--auto]" >&2; exit 2 ;;   # an old timer unit's --if-changed must not start an update by hand
esac
install -d -m 700 "$STATE"
exec 9>"$STATE/lock"; flock -n 9 || { echo "Another usher-update is running."; exit 0; }
# Under systemd, stdout and stderr already go to the journal as usher-update, so log each line once
# there (<3> marks an error) and use logger only when run by hand.
if [ -n "${JOURNAL_STREAM:-}" ]; then
  say() { echo "$1"; }
  bad() { echo "<3>$1" >&2; }
else
  say() { echo "$1"; logger -t usher-update -p user.info -- "$1"; }
  bad() { echo "$1" >&2; logger -t usher-update -p user.err -- "$1"; }
fi
post() {   # one JSON report to Usher on this server; never fails the update
  curl -fsS --max-time 5 -X POST -H 'Content-Type: application/json' -d "$1" \
    http://127.0.0.1:8484/internal/update-result >/dev/null 2>&1 || true
}
report() {   # tell Usher how this update ended (built or rolled_back), so Settings can show it
  post "{\"result\": \"$1\", \"version\": \"$2\"}"
}
checked() {   # checked HELD FAILED (true or false): the newest release, so Settings can show whether updates keep arriving
  post "{\"result\": \"checked\", \"newest\": \"$NEWEST\", \"held\": $1, \"failed\": $2}"
}
setver() {   # USHER_VERSION in .env: the one place the version is written, and the one the image tag reads; empty removes it
  [ -f "$DIR/.env" ] || { bad "No $DIR/.env: run setup.sh again."; exit 1; }
  ( umask 077
    # grep's exit 1 only means no line is left; any other failure must stop before .env is replaced
    grep -v '^USHER_VERSION=' "$DIR/.env" > "$DIR/.env.new" || [ $? -eq 1 ]
    [ -z "$1" ] || printf 'USHER_VERSION=%s\n' "$1" >> "$DIR/.env.new"
    mv "$DIR/.env.new" "$DIR/.env" )
}
# The image's health check asks /healthz. Compose recreates the container when the image changes, so a
# healthy container runs the version in .env.
up() { docker compose up -d "$@" --wait --wait-timeout 120; }
atleast() {   # atleast 2.20.2 v2.29.1-desktop.1: the second version is the first or later (as in setup.sh)
  local IFS=. want have i v=${2#v}
  read -ra want <<< "$1"; read -ra have <<< "${v%%[!0-9.]*}"
  for i in 0 1 2; do
    [ "$((10#${have[i]:-0}))" -eq "$((10#${want[i]:-0}))" ] || { [ "$((10#${have[i]:-0}))" -gt "$((10#${want[i]:-0}))" ]; return; }
  done
}
newer() {   # newer 1.5.0 1.4.6: the first version is later than the second
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)" = "$1" ]
}

REPO=$(sed -n 's/^USHER_REPO=//p' "$DIR/site.env" 2>/dev/null | tail -n 1 || true)
case $REPO in
  https://*) ;;
  *) bad "USHER_REPO in $DIR/site.env must be an https:// address."; exit 1 ;;
esac
# The newest release is the highest vX.Y.Z tag: the Release workflow tags a version only when it publishes it.
if ! TAGS=$(git ls-remote --tags --refs "$REPO" 'v*'); then
  if [ -n "$(find "$STATE/fetched" -mmin +1440 2>/dev/null)" ]; then
    bad "Usher updates: can't read the releases from GitHub for over a day (network or address)."
  fi
  [ $AUTO = 1 ] && exit 0   # a short outage isn't worth a failed unit in the digest
  exit 1
fi
NEWEST=$(printf '%s\n' "$TAGS" | sed -n 's#.*refs/tags/v\([0-9]\{1,6\}\.[0-9]\{1,6\}\.[0-9]\{1,6\}\)$#\1#p' \
         | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)
if [ -z "$NEWEST" ]; then
  bad "Usher updates: $REPO has no release yet."
  [ $AUTO = 1 ] && exit 0
  exit 1
fi
touch "$STATE/fetched"

# What is running: the version Usher itself reports, as Settings shows it.
RUNNING=$({ curl -fsS --max-time 5 http://127.0.0.1:8484/healthz 2>/dev/null || true; } | sed -n 's/.*"version": *"\([0-9]\{1,6\}\.[0-9]\{1,6\}\.[0-9]\{1,6\}\)".*/\1/p')
if [ -z "$RUNNING" ] && [ $AUTO = 1 ]; then
  bad "Usher updates: Usher doesn't answer on 127.0.0.1:8484, so nothing was updated. Look at: sudo docker logs --tail 50 usher"
  exit 1
fi
if [ -n "$RUNNING" ] && ! newer "$NEWEST" "$RUNNING"; then
  checked false false
  [ $AUTO = 1 ] || echo "Already up to date: $RUNNING"
  exit 0
fi
if [ $AUTO = 1 ] && [ "$(cat "$STATE/failed" 2>/dev/null)" = "$NEWEST" ]; then
  checked false true
  exit 0
fi

# --wait-timeout and start_interval in compose.yaml need Compose 2.20.2; an older one would fail the update and
# then the rollback too, while the running Usher is fine. Hold instead.
COMPOSE=$(docker compose version --short 2>/dev/null || true)
if ! atleast 2.20.2 "$COMPOSE"; then
  if [ $AUTO = 0 ] || [ "$(cat "$STATE/held" 2>/dev/null)" != "$NEWEST" ]; then
    echo "$NEWEST" > "$STATE/held"
    bad "Usher update held: $NEWEST needs Docker Compose 2.20.2 or later (found ${COMPOSE:-none}). Update it, then run: sudo usher-update"
  fi
  checked true false
  [ $AUTO = 1 ] && exit 0
  exit 1
fi

say "Usher: updating ${RUNNING:-the version in .env} to $NEWEST"
cd "$DIR"
PINNED=$(sed -n 's/^USHER_VERSION=//p' "$DIR/.env" 2>/dev/null | tail -n 1 || true)   # what .env said, to put back as it was
setver "$NEWEST"
# The image exists a little after its tag: until it does, nothing has changed on this machine.
if ! docker compose pull -q; then
  setver "$PINNED"
  bad "Usher $NEWEST can't be downloaded yet (its image may still be being published); nothing was changed."
  checked false false
  [ $AUTO = 1 ] && exit 0
  exit 1
fi
if up; then
  rm -f "$STATE/held" "$STATE/failed"
  say "Usher updated to $NEWEST"
  report built "$NEWEST"
  checked false false
  exit 0
fi

echo "$NEWEST" > "$STATE/failed"
if [ -z "$RUNNING" ]; then
  bad "Usher $NEWEST failed to start, and there is no earlier version to go back to. Look now: sudo docker logs --tail 50 usher"
  exit 1
fi
bad "Usher $NEWEST failed to start; going back to $RUNNING."
setver "$RUNNING"
if up --force-recreate; then
  bad "Usher is back on $RUNNING; it won't try $NEWEST again by itself."
  report rolled_back "$RUNNING"
  checked false true
else
  bad "Usher $RUNNING did not come up either. Look now: sudo docker logs --tail 50 usher"
fi
exit 1
